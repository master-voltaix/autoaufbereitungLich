{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/keramikversiegelung.html",
      "destination": "/lackpolitur.html",
      "permanent": true
    },
    {
      "source": "/aussenaufbereitung.html",
      "destination": "/autoaufbereitung.html",
      "permanent": true
    },
    {
      "source": "/smart-repair.html",
      "destination": "/lackierung.html",
      "permanent": true
    }
  ]
}